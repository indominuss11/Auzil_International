# Copy this file to .env.local and fill in real values.
# Never commit an actual .env or .env.local file.

# Resend (transactional email for enquiry/quote forms)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Cloudflare Turnstile (bot protection on public forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Canonical site URL, used for metadata, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.auzilinternational.example
